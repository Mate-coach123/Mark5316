{% doc %}
  @prompt
    Create a fully customizable Shopify "versus" comparison section that visually compares the hero product against 2 or more competitors, displayed side by side with images, a VS badge in between, and feature lists below each product.
    Section header:
    An optional bold centered heading above the comparison with font size, color, and weight controls. Optional short subheading below it.
    Product columns:
    Support 2 to 4 product columns displayed side by side on desktop. Each column contains: an editable product name label above the image with font size, color, and weight controls; an image upload field with border radius, width, and height controls; an optional badge/label overlay on the image (e.g. "LIMITÁLT") with text, background color, text color, font size, position picker (top-left, top-right, bottom-left, bottom-right), and border radius control.
    VS badges:
    A circular VS badge automatically appears between each pair of adjacent product columns. Badge background color picker. Badge text color picker. Badge size control. Badge font size and weight controls. Badge border toggle with color and thickness.
    Feature list rows:
    Below the images, each product column shows a vertical list of up to 6 feature items. Each item has: editable text field; icon mode selector per item — checkmark (✓) or cross (✗); icon background color picker; icon color picker; item background color picker; item border radius control; item font size and color. Hero product column items default to filled colored background with checkmark. Competitor columns default to light background with cross icon.
    Hero column highlight:
    One column can be designated as the hero product. Hero column gets: distinct background or border highlight; bolder header label; independently configurable feature item colors.
    Layout:
    Desktop: all product columns side by side in a single row with VS badges between them. Mobile: columns stack vertically with VS badge between each pair. Gap between columns adjustable for desktop and mobile separately. Max content width control. Cards centered within the section.
    Section styling:
    Section background color picker. Top, bottom, left, right padding controls. Max content width control.
    Typography:
    All text elements have individual font size, color, font weight, and alignment controls.
    Every setting must be exposed and clearly labeled in the Shopify theme editor sidebar, organized into logical groups: Section Header, Product Columns (1–4), VS Badge, Feature Lists, Hero Column, Layout, Section Styling.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-versus-{{ ai_gen_id }} { display: block; width: 100%; background: {{ block.settings.section_bg }}; padding: {{ block.settings.pad_top }}px {{ block.settings.pad_right }}px {{ block.settings.pad_bottom }}px {{ block.settings.pad_left }}px; }
  .ai-versus-{{ ai_gen_id }}__inner { width: 100%; max-width: {{ block.settings.max_width }}px; margin: 0 auto; }
  .ai-versus-{{ ai_gen_id }}__heading { margin: 0 0 8px; text-align: {{ block.settings.header_align }}; font-size: {{ block.settings.heading_size }}px; line-height: 1.2; font-weight: {{ block.settings.heading_weight }}; color: {{ block.settings.heading_color }}; }
  .ai-versus-{{ ai_gen_id }}__subheading { margin: 0 0 28px; text-align: {{ block.settings.header_align }}; font-size: {{ block.settings.subheading_size }}px; color: {{ block.settings.subheading_color }}; }
  .ai-versus-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat({{ block.settings.column_count }}, minmax(0, 1fr)); gap: {{ block.settings.desktop_gap }}px; align-items: stretch; }
  .ai-versus-{{ ai_gen_id }}__card { position: relative; min-width: 0; padding: 16px; text-align: {{ block.settings.card_align }}; background: {{ block.settings.card_bg }}; border: {% if block.settings.highlight_border %}{{ block.settings.highlight_thickness }}px solid {{ block.settings.highlight_color }}{% else %}1px solid transparent{% endif %}; border-radius: {{ block.settings.card_radius }}px; }
  .ai-versus-{{ ai_gen_id }}__card.is-hero { background: {{ block.settings.hero_bg }}; border-color: {{ block.settings.hero_border }}; }
  .ai-versus-{{ ai_gen_id }}__name { display: block; margin: 0 0 12px; font-size: {{ block.settings.name_size }}px; font-weight: {{ block.settings.name_weight }}; color: {{ block.settings.name_color }}; }
  .ai-versus-{{ ai_gen_id }}__card.is-hero .ai-versus-{{ ai_gen_id }}__name { font-weight: 700; }
  .ai-versus-{{ ai_gen_id }}__media { position: relative; width: {{ block.settings.image_width }}%; height: {{ block.settings.image_height }}px; margin: 0 auto 16px; overflow: hidden; border-radius: {{ block.settings.image_radius }}px; }
  .ai-versus-{{ ai_gen_id }}__media img, .ai-versus-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-versus-{{ ai_gen_id }}__placeholder { height: 100%; background: #f1f1f1; }
  .ai-versus-{{ ai_gen_id }}__placeholder svg { color: #666; }
  .ai-versus-{{ ai_gen_id }}__label { position: absolute; z-index: 1; padding: 5px 9px; font-size: {{ block.settings.label_size }}px; line-height: 1.2; background: {{ block.settings.label_bg }}; color: {{ block.settings.label_color }}; border-radius: {{ block.settings.label_radius }}px; }
  .ai-versus-{{ ai_gen_id }}__label--tl { top: 8px; left: 8px; }.ai-versus-{{ ai_gen_id }}__label--tr { top: 8px; right: 8px; }.ai-versus-{{ ai_gen_id }}__label--bl { bottom: 8px; left: 8px; }.ai-versus-{{ ai_gen_id }}__label--br { bottom: 8px; right: 8px; }
  .ai-versus-{{ ai_gen_id }}__features { display: grid; gap: 8px; text-align: left; }
  .ai-versus-{{ ai_gen_id }}__feature { display: flex; align-items: center; gap: 9px; min-height: 38px; padding: 8px 10px; background: {{ block.settings.feature_bg }}; border-radius: {{ block.settings.feature_radius }}px; color: {{ block.settings.feature_text }}; font-size: {{ block.settings.feature_size }}px; }
  .ai-versus-{{ ai_gen_id }}__card.is-hero .ai-versus-{{ ai_gen_id }}__feature { background: {{ block.settings.hero_feature_bg }}; color: {{ block.settings.hero_feature_text }}; }
  .ai-versus-{{ ai_gen_id }}__icon { display: inline-flex; flex: 0 0 22px; width: 22px; height: 22px; align-items: center; justify-content: center; border-radius: 50%; background: {{ block.settings.icon_bg }}; color: {{ block.settings.icon_color }}; font-weight: 700; line-height: 1; }
  .ai-versus-{{ ai_gen_id }}__card.is-hero .ai-versus-{{ ai_gen_id }}__icon { background: {{ block.settings.hero_icon_bg }}; color: {{ block.settings.hero_icon_color }}; }
  .ai-versus-{{ ai_gen_id }}__vs { position: absolute; z-index: 2; top: 50%; right: calc(-1 * {{ block.settings.desktop_gap }}px / 2 - {{ block.settings.vs_size }}px / 2); transform: translate(50%, -50%); width: {{ block.settings.vs_size }}px; height: {{ block.settings.vs_size }}px; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: {{ block.settings.vs_bg }}; color: {{ block.settings.vs_text }}; font-size: {{ block.settings.vs_font_size }}px; font-weight: {{ block.settings.vs_weight }}; {% if block.settings.vs_border %}border: {{ block.settings.vs_border_width }}px solid {{ block.settings.vs_border_color }};{% else %}border: 0;{% endif %} }
  @media screen and (max-width: 749px) {
    .ai-versus-{{ ai_gen_id }} { padding: {{ block.settings.pad_top | divided_by: 2 }}px {{ block.settings.pad_right | divided_by: 2 }}px {{ block.settings.pad_bottom | divided_by: 2 }}px {{ block.settings.pad_left | divided_by: 2 }}px; }
    .ai-versus-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: {{ block.settings.mobile_gap }}px; }
    .ai-versus-{{ ai_gen_id }}__vs { top: auto; right: 50%; bottom: calc(-1 * {{ block.settings.mobile_gap }}px / 2 - {{ block.settings.vs_size }}px / 2); transform: translate(50%, 50%); }
    .ai-versus-{{ ai_gen_id }}__card:not(:last-child) { margin-bottom: 0; }
  }
{% endstyle %}
<section class="ai-versus-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-versus-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-versus-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.subheading != blank %}<div class="ai-versus-{{ ai_gen_id }}__subheading">{{ block.settings.subheading | escape }}</div>{% endif %}
    <div class="ai-versus-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        {% if i <= block.settings.column_count %}
          {% assign name_key = 'name_' | append: i %}{% assign image_key = 'image_' | append: i %}{% assign label_key = 'label_' | append: i %}{% assign features_key = 'features_' | append: i %}
          {% assign product_name = block.settings[name_key] %}{% assign product_image = block.settings[image_key] %}{% assign product_label = block.settings[label_key] %}{% assign feature_text = block.settings[features_key] %}
          {% assign feature_items = feature_text | newline_to_br | split: '<br />' %}
          {% assign placement_class = 'tl' %}
          {% if block.settings.label_position == 'tr' %}{% assign placement_class = 'tr' %}{% elsif block.settings.label_position == 'bl' %}{% assign placement_class = 'bl' %}{% elsif block.settings.label_position == 'br' %}{% assign placement_class = 'br' %}{% endif %}
          <article class="ai-versus-{{ ai_gen_id }}__card{% if i == block.settings.hero_column %} is-hero{% endif %}">
            {% if product_name != blank %}<h3 class="ai-versus-{{ ai_gen_id }}__name">{{ product_name | escape }}</h3>{% endif %}
            <div class="ai-versus-{{ ai_gen_id }}__media">
              {% if product_image %}<img src="{{ product_image | image_url: width: 1200 }}" alt="{{ product_image.alt | default: product_name | escape }}" loading="lazy" width="{{ product_image.width }}" height="{{ product_image.height }}">
              {% else %}<div class="ai-versus-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
              {% if product_label != blank %}<span class="ai-versus-{{ ai_gen_id }}__label ai-versus-{{ ai_gen_id }}__label--{{ placement_class }}">{{ product_label | escape }}</span>{% endif %}
            </div>
            <div class="ai-versus-{{ ai_gen_id }}__features">
              {% for feature in feature_items limit: 6 %}
                {% assign clean_feature = feature | strip %}{% if clean_feature != blank %}
                  {% assign show_check = false %}{% if i == block.settings.hero_column or block.settings.feature_mode == 'check' %}{% assign show_check = true %}{% endif %}
                  <div class="ai-versus-{{ ai_gen_id }}__feature"><span class="ai-versus-{{ ai_gen_id }}__icon" aria-hidden="true">{% if show_check %}✓{% else %}✗{% endif %}</span><span>{{ clean_feature | escape }}</span></div>
                {% endif %}
              {% endfor %}
            </div>
            {% unless forloop.last %}<span class="ai-versus-{{ ai_gen_id }}__vs" aria-label="Versus">VS</span>{% endunless %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Versus comparison",
  "settings": [
    {"type":"header","content":"Section Header"},
    {"type":"text","id":"heading","label":"Heading","default":"How we compare"},
    {"type":"range","id":"heading_size","label":"Heading size","min":18,"max":48,"step":2,"unit":"px","default":30},
    {"type":"color","id":"heading_color","label":"Heading color","default":"#1A1A1A"},
    {"type":"range","id":"heading_weight","label":"Heading weight","min":400,"max":900,"step":100,"default":700},
    {"type":"text","id":"subheading","label":"Subheading","default":"See the difference for yourself"},
    {"type":"range","id":"subheading_size","label":"Subheading size","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"color","id":"subheading_color","label":"Subheading color","default":"#555555"},
    {"type":"select","id":"header_align","label":"Header alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},
    {"type":"header","content":"Product Columns (1–4)"},
    {"type":"select","id":"column_count","label":"Number of columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"3"},
    {"type":"text","id":"name_1","label":"Column 1 name","default":"Vellum"},{"type":"image_picker","id":"image_1","label":"Column 1 image"},{"type":"text","id":"label_1","label":"Column 1 image label","default":"LIMITÁLT"},{"type":"textarea","id":"features_1","label":"Column 1 features","default":"Premium materials\nErgonomic design\nMade to last"},
    {"type":"text","id":"name_2","label":"Column 2 name","default":"Competitor A"},{"type":"image_picker","id":"image_2","label":"Column 2 image"},{"type":"text","id":"label_2","label":"Column 2 image label"},{"type":"textarea","id":"features_2","label":"Column 2 features","default":"Standard materials\nBasic design\nLimited durability"},
    {"type":"text","id":"name_3","label":"Column 3 name","default":"Competitor B"},{"type":"image_picker","id":"image_3","label":"Column 3 image"},{"type":"text","id":"label_3","label":"Column 3 image label"},{"type":"textarea","id":"features_3","label":"Column 3 features","default":"Standard materials\nBasic design\nLimited durability"},
    {"type":"text","id":"name_4","label":"Column 4 name","default":"Competitor C"},{"type":"image_picker","id":"image_4","label":"Column 4 image"},{"type":"text","id":"label_4","label":"Column 4 image label"},{"type":"textarea","id":"features_4","label":"Column 4 features","default":"Standard materials\nBasic design\nLimited durability"},
    {"type":"range","id":"name_size","label":"Product name size","min":14,"max":30,"step":1,"unit":"px","default":18},{"type":"color","id":"name_color","label":"Product name color","default":"#1A1A1A"},{"type":"range","id":"name_weight","label":"Product name weight","min":400,"max":900,"step":100,"default":600},
    {"type":"range","id":"image_width","label":"Image width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"image_height","label":"Image height","min":100,"max":400,"step":20,"unit":"px","default":220},{"type":"range","id":"image_radius","label":"Image radius","min":0,"max":40,"step":2,"unit":"px","default":12},
    {"type":"text","id":"label_note","label":"Label setting note","default":"Image label styling is shared across columns"},{"type":"color","id":"label_bg","label":"Label background","default":"#80552C"},{"type":"color","id":"label_color","label":"Label text","default":"#FFFFFF"},{"type":"range","id":"label_size","label":"Label font size","min":10,"max":20,"step":1,"unit":"px","default":12},{"type":"select","id":"label_position","label":"Label position","options":[{"value":"tl","label":"Top left"},{"value":"tr","label":"Top right"},{"value":"bl","label":"Bottom left"},{"value":"br","label":"Bottom right"}],"default":"tl"},{"type":"range","id":"label_radius","label":"Label radius","min":0,"max":20,"step":1,"unit":"px","default":4},
    {"type":"header","content":"VS Badge"},{"type":"color","id":"vs_bg","label":"Background","default":"#80552C"},{"type":"color","id":"vs_text","label":"Text","default":"#FFFFFF"},{"type":"range","id":"vs_size","label":"Badge size","min":32,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"vs_font_size","label":"Font size","min":10,"max":24,"step":1,"unit":"px","default":14},{"type":"range","id":"vs_weight","label":"Font weight","min":400,"max":900,"step":100,"default":700},{"type":"checkbox","id":"vs_border","label":"Show badge border","default":false},{"type":"color","id":"vs_border_color","label":"Border color","default":"#FFFFFF"},{"type":"range","id":"vs_border_width","label":"Border thickness","min":1,"max":5,"step":1,"unit":"px","default":1},
    {"type":"header","content":"Feature Lists"},{"type":"select","id":"feature_mode","label":"Competitor icon","options":[{"value":"cross","label":"Cross"},{"value":"check","label":"Checkmark"}],"default":"cross"},{"type":"color","id":"feature_bg","label":"Competitor item background","default":"#F3F4F5"},{"type":"color","id":"feature_text","label":"Competitor text color","default":"#333333"},{"type":"color","id":"icon_bg","label":"Competitor icon background","default":"#E2E4E6"},{"type":"color","id":"icon_color","label":"Competitor icon color","default":"#333333"},{"type":"range","id":"feature_radius","label":"Item radius","min":0,"max":20,"step":1,"unit":"px","default":6},{"type":"range","id":"feature_size","label":"Item font size","min":12,"max":20,"step":1,"unit":"px","default":14},
    {"type":"header","content":"Hero Column"},{"type":"select","id":"hero_column","label":"Hero product column","options":[{"value":"1","label":"Column 1"},{"value":"2","label":"Column 2"},{"value":"3","label":"Column 3"},{"value":"4","label":"Column 4"}],"default":"1"},{"type":"color","id":"hero_bg","label":"Hero card background","default":"#FFF9F2"},{"type":"color","id":"hero_border","label":"Hero border color","default":"#80552C"},{"type":"checkbox","id":"highlight_border","label":"Use card border on other columns","default":false},{"type":"range","id":"highlight_thickness","label":"Hero border thickness","min":1,"max":6,"step":1,"unit":"px","default":2},{"type":"color","id":"highlight_color","label":"Other card border color","default":"#E2E4E6"},{"type":"color","id":"hero_feature_bg","label":"Hero feature background","default":"#80552C"},{"type":"color","id":"hero_feature_text","label":"Hero feature text","default":"#FFFFFF"},{"type":"color","id":"hero_icon_bg","label":"Hero icon background","default":"#FFFFFF"},{"type":"color","id":"hero_icon_color","label":"Hero icon color","default":"#80552C"},
    {"type":"header","content":"Layout"},{"type":"range","id":"desktop_gap","label":"Desktop column gap","min":24,"max":80,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_gap","label":"Mobile column gap","min":32,"max":80,"step":4,"unit":"px","default":48},{"type":"range","id":"max_width","label":"Maximum content width","min":700,"max":1600,"step":50,"unit":"px","default":1200},{"type":"select","id":"card_align","label":"Card alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},
    {"type":"header","content":"Section Styling"},{"type":"color","id":"section_bg","label":"Section background","default":"#FFFFFF"},{"type":"color","id":"card_bg","label":"Card background","default":"#FFFFFF"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"pad_top","label":"Top padding","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"pad_bottom","label":"Bottom padding","min":0,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"pad_left","label":"Left padding","min":0,"max":80,"step":5,"unit":"px","default":20},{"type":"range","id":"pad_right","label":"Right padding","min":0,"max":80,"step":5,"unit":"px","default":20},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets":[{"name":"Versus comparison"}],
  "tag":null,
  "class":"versus-comparison-block"
}
{% endschema %}