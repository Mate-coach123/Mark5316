    "custom_liquid_WLefVM": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"vellum-steps-wrapper\">\n  <p class=\"vellum-steps-eyebrow\">EGYSZERŰBB, MINT GONDOLNÁD</p>\n  <h2 class=\"vellum-steps-title\">Három lépés a saját Vellumodig</h2>\n  <div class=\"vellum-steps-grid\">\n\n    <div class=\"vellum-step-card\">\n      <div class=\"vellum-step-number\">1</div>\n      <div class=\"vellum-step-emoji\">✍️</div>\n      <h3 class=\"vellum-step-heading\">Mondd el, mit szeretnél</h3>\n      <p class=\"vellum-step-desc\">Elküldöd a saját szövegedet, vagy válaszolsz néhány kérdésre, és megfogalmazzuk helyetted.</p>\n    </div>\n\n    <div class=\"vellum-step-card\">\n      <div class=\"vellum-step-number\">2</div>\n      <div class=\"vellum-step-emoji\">📩</div>\n      <h3 class=\"vellum-step-heading\">Hagyd jóvá a tervet</h3>\n      <p class=\"vellum-step-desc\">Emailben megkapod a teljes szöveget és a designt. Ha valamin változtatnál, jelzed, és csak utána készül el.</p>\n    </div>\n\n    <div class=\"vellum-step-card\">\n      <div class=\"vellum-step-number\">3</div>\n      <div class=\"vellum-step-emoji\">🎁</div>\n      <h3 class=\"vellum-step-heading\">Díszdobozban megérkezik</h3>\n      <p class=\"vellum-step-desc\">5–6 munkanapon belül nálad van, ajándék díszdobozban, azonnal átadható formában.</p>\n    </div>\n\n  </div>\n</div>\n<style>\n  .vellum-steps-wrapper {\n    background: #ffffff;\n    padding: 36px 20px 32px;\n    text-align: center;\n    font-family: 'Inter', 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;\n  }\n  .vellum-steps-eyebrow {\n    font-size: 17px;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    color: #80552C;\n    text-transform: uppercase;\n    margin: 0 0 10px;\n  }\n  .vellum-steps-title {\n    font-size: 26px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 28px;\n    line-height: 1.2;\n  }\n  .vellum-steps-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n    max-width: 860px;\n    margin: 0 auto;\n  }\n  .vellum-step-card {\n    background: #FAF6F1;\n    border: 1px solid #E8D9C6;\n    border-radius: 16px;\n    padding: 28px 20px 24px;\n    position: relative;\n    text-align: center;\n  }\n  .vellum-step-number {\n    position: absolute;\n    top: -14px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 28px;\n    height: 28px;\n    border-radius: 50%;\n    background: #80552C;\n    color: #fff;\n    font-size: 13px;\n    font-weight: 800;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .vellum-step-emoji {\n    font-size: 32px;\n    margin: 8px 0 14px;\n  }\n  .vellum-step-heading {\n    font-size: 15px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 0 10px;\n    line-height: 1.3;\n  }\n  .vellum-step-desc {\n    font-size: 13px;\n    color: #555;\n    line-height: 1.55;\n    margin: 0;\n  }\n  @media (max-width: 749px) {\n    .vellum-steps-grid {\n      grid-template-columns: 1fr;\n      gap: 28px;\n    }\n    .vellum-steps-title {\n      font-size: 20px;\n    }\n    .vellum-steps-eyebrow {\n      font-size: 14px;\n    }\n  }\n</style>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_TrXYA7": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"vellum-why-wrapper\">\n  <p class=\"vellum-why-eyebrow\">ISMERŐS?</p>\n  <h2 class=\"vellum-why-title\">Ajándékot venni könnyű. Olyat adni, ami számít, már nem.</h2>\n  <div class=\"vellum-why-grid\">\n\n    <div class=\"vellum-why-card\">\n      <div class=\"vellum-why-emoji\">🛍️</div>\n      <h3 class=\"vellum-why-heading\">„Már mindene megvan”</h3>\n      <p class=\"vellum-why-desc\">Nem kell újabb tárgyat keresned a polcára. A Vellumon az van, amit csak te adhatsz neki: a közös történetetek.</p>\n    </div>\n\n    <div class=\"vellum-why-card\">\n      <div class=\"vellum-why-emoji\">🥀</div>\n      <h3 class=\"vellum-why-heading\">Pár hét, és elfelejtődik</h3>\n      <p class=\"vellum-why-desc\">A virág elhervad, a parfüm elfogy, a képeslap elkallódik. Egy tekercsre írt üzenetet évek múlva is elővesz és újraolvas.</p>\n    </div>\n\n    <div class=\"vellum-why-card\">\n      <div class=\"vellum-why-emoji\">🎯</div>\n      <h3 class=\"vellum-why-heading\">Félsz, hogy mellényúlsz</h3>\n      <p class=\"vellum-why-desc\">Nincs méret, szín vagy ízlés, amit eltéveszthetsz. Arról szól, amit együtt éltetek át, és a tervet úgyis jóváhagyod, mielőtt elkészül.</p>\n    </div>\n\n    <div class=\"vellum-why-card\">\n      <div class=\"vellum-why-emoji\">💬</div>\n      <h3 class=\"vellum-why-heading\">Érzed, csak nehéz kimondani</h3>\n      <p class=\"vellum-why-desc\">A legfontosabb dolgokat ritkán mondjuk el. Ha nem jönnek a szavak, néhány kérdés alapján segítünk megfogalmazni.</p>\n    </div>\n\n  </div>\n</div>\n<style>\n  .vellum-why-wrapper {\n    background: #FAF8F5;\n    padding: 48px 20px 52px;\n    text-align: center;\n    font-family: inherit;\n  }\n  .vellum-why-eyebrow {\n    font-size: 16px;\n    font-weight: 700;\n    letter-spacing: 0.12em;\n    color: #80552C;\n    text-transform: uppercase;\n    margin: 0 0 12px;\n  }\n  .vellum-why-title {\n    font-size: 32px;\n    font-weight: 800;\n    color: #1a1a1a;\n    margin: 0 auto 36px;\n    line-height: 1.2;\n    max-width: 760px;\n  }\n  .vellum-why-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 22px;\n    max-width: 900px;\n    margin: 0 auto;\n    text-align: left;\n  }\n  .vellum-why-card {\n    background: #F3E9DD;\n    border: 1px solid #C9A882;\n    border-radius: 10px;\n    padding: 24px 22px 22px;\n  }\n  .vellum-why-emoji {\n    font-size: 28px;\n    line-height: 1;\n    margin: 0 0 14px;\n  }\n  .vellum-why-heading {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1a1a1a;\n    margin: 0 0 10px;\n    line-height: 1.3;\n  }\n  .vellum-why-desc {\n    font-size: 13.5px;\n    color: #5a5049;\n    line-height: 1.6;\n    margin: 0;\n  }\n  @media (max-width: 749px) {\n    .vellum-why-wrapper {\n      padding: 36px 16px 40px;\n    }\n    .vellum-why-grid {\n      grid-template-columns: 1fr;\n      gap: 14px;\n    }\n    .vellum-why-title {\n      font-size: 22px;\n      margin-bottom: 26px;\n    }\n    .vellum-why-eyebrow {\n      font-size: 13px;\n    }\n  }\n</style>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
