{% doc %}
  @prompt
    Create a custom comparison section for my product page. The layout should be two cards side by side with a circular "VS" badge between them, like a "why we're different" comparison.
    
    STRUCTURE
    - Centered section heading at the top: "Miért más a Vellum?"
    - Left card (our product):
      - Card title: "Vellum"
      - Square image with rounded corners (image picker setting)
      - 3 list items, each in its own dark pill/row with a white circular checkmark icon on the left:
        1. "A ti saját történetetek van rajta"
        2. "Évekig megőrizhető, újra elolvasható"
        3. "Senki más nem kaphatja meg ugyanezt"
    - Center: circular "VS" badge, vertically centered between the two cards on desktop
    - Right card (alternatives):
      - Card title: "Hagyományos ajándékok"
      - Square image with rounded corners (image picker setting)
      - 3 list items, each in its own light grey pill/row with a small white circle containing an "✗" icon on the left:
        1. "Bárki más is kaphatta volna"
        2. "Pár hét múlva elhervad vagy elfogy"
        3. "Egy idő után nem tudod, mit adj"
    
    STYLING
    - Section background: white
    - Heading: bold, about 40px on desktop, color #80552C
    - VS badge: 52px circle, background #80552C, white bold text
    - Left card: light background #FAF6F1, 16px rounded corners, padding around the content. Its list rows: background #3B2A1F, white text, 8px rounded corners
    - Right card: no background, just the title, image and list. Its list rows: background #EDEDED, dark text #2D2D2D, 8px rounded corners
    - Card titles: bold, about 17px, centered, dark text
    - List text: about 14px, semi-bold
    - Images: same size on both sides, object-fit cover, 12px rounded corners
    - Max content width about 760px, centered
    
    MOBILE (under 750px)
    - Stack the cards vertically: left card first, then the VS badge centered, then the right card
    - Heading about 28px
    - Full-width cards
    
    SETTINGS
    Make all texts, both images, the accent color and the dark row color editable in the theme editor. Use blocks for the list items so I can add or remove rows on each side.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:36px 16px;background:#fff;color:#2d2d2d;box-sizing:border-box}
  .ai-comparison-{{ ai_gen_id }} *,.ai-comparison-{{ ai_gen_id }} *::before,.ai-comparison-{{ ai_gen_id }} *::after{box-sizing:border-box}
  .ai-comparison-{{ ai_gen_id }}__inner{max-width:760px;margin:0 auto}
  .ai-comparison-{{ ai_gen_id }}__heading{margin:0 0 30px;text-align:center;color:{{ block.settings.accent_color }};font-size:40px;line-height:1.15;font-weight:700}
  .ai-comparison-{{ ai_gen_id }}__layout{display:grid;grid-template-columns:minmax(0,1fr) 52px minmax(0,1fr);align-items:center;gap:12px}
  .ai-comparison-{{ ai_gen_id }}__card{min-width:0;padding:18px;border-radius:16px;background:#faf6f1}
  .ai-comparison-{{ ai_gen_id }}__card--other{background:transparent}
  .ai-comparison-{{ ai_gen_id }}__title{margin:0 0 14px;text-align:center;font-size:17px;line-height:1.3;font-weight:700;color:#2d2d2d}
  .ai-comparison-{{ ai_gen_id }}__image-wrap{position:relative;width:100%;aspect-ratio:1/1;margin-bottom:14px;overflow:hidden;border-radius:12px;background:#f2f2f2}
  .ai-comparison-{{ ai_gen_id }}__image-wrap img,.ai-comparison-{{ ai_gen_id }}__image-wrap svg{display:block;width:100%;height:100%;object-fit:cover}
  .ai-comparison-{{ ai_gen_id }}__empty{position:absolute;right:8px;bottom:8px;left:8px;color:#444;text-align:center;font-size:12px}
  .ai-comparison-{{ ai_gen_id }}__list{display:grid;gap:8px}
  .ai-comparison-{{ ai_gen_id }}__row{display:flex;align-items:center;gap:9px;min-height:44px;padding:9px 10px;border-radius:8px;background:{{ block.settings.dark_row_color }};color:#fff;font-size:14px;line-height:1.35;font-weight:600}
  .ai-comparison-{{ ai_gen_id }}__card--other .ai-comparison-{{ ai_gen_id }}__row{background:#ededed;color:#2d2d2d}
  .ai-comparison-{{ ai_gen_id }}__icon{display:inline-flex;flex:0 0 22px;width:22px;height:22px;align-items:center;justify-content:center;border-radius:50%;background:#fff;color:{{ block.settings.dark_row_color }};font-size:14px;font-weight:700;line-height:1}
  .ai-comparison-{{ ai_gen_id }}__card--other .ai-comparison-{{ ai_gen_id }}__icon{color:#2d2d2d}
  .ai-comparison-{{ ai_gen_id }}__vs{display:flex;width:52px;height:52px;align-items:center;justify-content:center;border-radius:50%;background:{{ block.settings.accent_color }};color:#fff;font-size:16px;font-weight:700}
  @media screen and (max-width:749px){.ai-comparison-{{ ai_gen_id }}{padding:26px 12px}.ai-comparison-{{ ai_gen_id }}__heading{margin-bottom:22px;font-size:28px}.ai-comparison-{{ ai_gen_id }}__layout{grid-template-columns:minmax(0,1fr);gap:12px}.ai-comparison-{{ ai_gen_id }}__card{width:100%;padding:16px}.ai-comparison-{{ ai_gen_id }}__vs{justify-self:center}}
{% endstyle %}

<div class="ai-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-comparison-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-comparison-{{ ai_gen_id }}__layout">
      <div class="ai-comparison-{{ ai_gen_id }}__card">
        {% if block.settings.left_title != blank %}<h3 class="ai-comparison-{{ ai_gen_id }}__title">{{ block.settings.left_title | escape }}</h3>{% endif %}
        <div class="ai-comparison-{{ ai_gen_id }}__image-wrap">{% if block.settings.left_image != blank %}<img src="{{ block.settings.left_image | image_url: width: 800 }}" alt="{{ block.settings.left_image.alt | escape }}" loading="lazy" width="{{ block.settings.left_image.width }}" height="{{ block.settings.left_image.height }}">{% else %}{{ 'image' | placeholder_svg_tag }}<span class="ai-comparison-{{ ai_gen_id }}__empty">Tölts fel egy képet</span>{% endif %}</div>
        <div class="ai-comparison-{{ ai_gen_id }}__list">
          {% for i in (1..3) %}{% assign row_key = 'our_row_' | append: i %}{% if block.settings[row_key] != blank %}<div class="ai-comparison-{{ ai_gen_id }}__row"><span class="ai-comparison-{{ ai_gen_id }}__icon" aria-hidden="true">✓</span><span>{{ block.settings[row_key] | escape }}</span></div>{% endif %}{% endfor %}
        </div>
      </div>
      <div class="ai-comparison-{{ ai_gen_id }}__vs" aria-label="Versus">VS</div>
      <div class="ai-comparison-{{ ai_gen_id }}__card ai-comparison-{{ ai_gen_id }}__card--other">
        {% if block.settings.right_title != blank %}<h3 class="ai-comparison-{{ ai_gen_id }}__title">{{ block.settings.right_title | escape }}</h3>{% endif %}
        <div class="ai-comparison-{{ ai_gen_id }}__image-wrap">{% if block.settings.right_image != blank %}<img src="{{ block.settings.right_image | image_url: width: 800 }}" alt="{{ block.settings.right_image.alt | escape }}" loading="lazy" width="{{ block.settings.right_image.width }}" height="{{ block.settings.right_image.height }}">{% else %}{{ 'image' | placeholder_svg_tag }}<span class="ai-comparison-{{ ai_gen_id }}__empty">Tölts fel egy képet</span>{% endif %}</div>
        <div class="ai-comparison-{{ ai_gen_id }}__list">
          {% for i in (1..3) %}{% assign row_key = 'other_row_' | append: i %}{% if block.settings[row_key] != blank %}<div class="ai-comparison-{{ ai_gen_id }}__row"><span class="ai-comparison-{{ ai_gen_id }}__icon" aria-hidden="true">✗</span><span>{{ block.settings[row_key] | escape }}</span></div>{% endif %}{% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Miért más a Vellum?" },
    { "type": "text", "id": "left_title", "label": "Left card title", "default": "Vellum" },
    { "type": "image_picker", "id": "left_image", "label": "Left image" },
    { "type": "text", "id": "right_title", "label": "Right card title", "default": "Hagyományos ajándékok" },
    { "type": "image_picker", "id": "right_image", "label": "Right image" },
    { "type": "header", "content": "Our product rows" },
    { "type": "text", "id": "our_row_1", "label": "Row 1", "default": "A ti saját történetetek van rajta" },
    { "type": "text", "id": "our_row_2", "label": "Row 2", "default": "Évekig megőrizhető, újra elolvasható" },
    { "type": "text", "id": "our_row_3", "label": "Row 3", "default": "Senki más nem kaphatja meg ugyanezt" },
    { "type": "header", "content": "Alternative rows" },
    { "type": "text", "id": "other_row_1", "label": "Row 1", "default": "Bárki más is kaphatta volna" },
    { "type": "text", "id": "other_row_2", "label": "Row 2", "default": "Pár hét múlva elhervad vagy elfogy" },
    { "type": "text", "id": "other_row_3", "label": "Row 3", "default": "Egy idő után nem tudod, mit adj" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#80552C" },
    { "type": "color", "id": "dark_row_color", "label": "Dark row color", "default": "#3B2A1F" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Product comparison" }],
  "tag": null,
  "class": "product-comparison-block"
}
{% endschema %}